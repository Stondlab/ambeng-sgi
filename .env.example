# SUPABASE CONFIG
# Copie este arquivo para .env.local e preencha com suas chaves

# Sua URL do Supabase (encontra em: Supabase Dashboard → Settings → API)
# Exemplo: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Sua Anon Key (encontra em: Supabase Dashboard → Settings → API → anon public)
# Exemplo: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI
